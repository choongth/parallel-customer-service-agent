# Copy this file to .env and fill in your values.
# Used by: faq_seed.py, load_test.py, and local development.
# Lambda functions get these from template.yaml at deploy time — not from this file.

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# AWS_PROFILE=default          # uncomment if using a named AWS CLI profile

# ── DynamoDB table names (must match template.yaml) ──────────────────────────
CONVERSATIONS_TABLE=Conversations
FAQ_TABLE=FAQCache

# ── SQS (set after `sam deploy` prints the Outputs) ──────────────────────────
SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/support-queue

# ── Bedrock model (must match template.yaml BEDROCK_MODEL_ID) ────────────────
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20240620-v1:0

# ── Load test ─────────────────────────────────────────────────────────────────
API_ENDPOINT=https://<api-id>.execute-api.<region>.amazonaws.com/Prod/support
